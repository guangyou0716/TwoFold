{
  "name": "twofold-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Trusted backend for TwoFold: receipt OCR, recurring transactions, invite codes, export/delete jobs.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
