rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // The requesting user's own profile document data.
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True when the requesting user belongs to the group with id `groupId`.
    // Authoritative via their own profile (no extra get()).
    function isMemberOfGroup(groupId) {
      return isSignedIn()
        && myProfile().keys().hasAny(['groupId'])
        && myProfile().groupId == groupId;
    }

    // True when the requesting user is a direct partner of `uid`.
    function isPartnerOf(uid) {
      return isSignedIn()
        && myProfile().keys().hasAny(['partnerId'])
        && myProfile().partnerId == uid;
    }

    // A group where the requesting user is one of the two partners.
    function isGroupPartner(group) {
      return group.partnerAId == request.auth.uid || group.partnerBId == request.auth.uid;
    }

    // A group whose id matches the requesting user's own groupId.
    function ownsGroupId(groupId) {
      return myProfile().groupId == groupId;
    }

    // Solo groups are named `solo_{uid}` and belong to exactly one user.
    function isSoloGroup(groupId) {
      return groupId == "solo_" + request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Server-owned documents: a Cloud Function (admin SDK) is the sole writer.
    // -------------------------------------------------------------------------
    function isServerAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // =========================================================================
    // Users collection
    //   - Owner manages their own full profile.
    //   - Partner may read the profile for display purposes.
    //   - Pairing uses a callable invite flow; unpaired users never enumerate
    //     or read another user's full profile.
    // =========================================================================
    match /users/{uid} {
      allow read: if isSignedIn() && (
        isOwner(uid)
        || isPartnerOf(uid)
      );
      allow create: if isSignedIn() && isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isSignedIn() && (
        // 1. Owner updates their own profile
        (
          isOwner(uid) && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupId', 'partnerId', 'isSolo']) || (
              // Case A: Going Solo
              request.resource.data.groupId == "solo_" + uid &&
              request.resource.data.partnerId == "" &&
              request.resource.data.isSolo == true
            ) || (
              // Case B: Resetting / Unlinking
              request.resource.data.groupId == "" &&
              request.resource.data.partnerId == "" &&
              request.resource.data.isSolo == true
            )
          )
        ) ||
        // 2. Partner unlinks this user (from Settings unlink batch)
        (
          isPartnerOf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId', 'groupId', 'isSolo']) &&
          request.resource.data.partnerId == "" &&
          request.resource.data.groupId == "" &&
          request.resource.data.isSolo == true
        )
      );
      allow delete: if isSignedIn() && isOwner(uid);
    }

    // =========================================================================
    // Groups collection
    //   - Read: group partners, or a user whose own groupId matches.
    //   - Create: partner(self) with a well-formed membership id.
    //   - Update: partners only; immutable ownership id and balances/streaks guarded.
    //   - Delete: disabled (removal runs through a privileged backend job).
    // =========================================================================
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        ownsGroupId(groupId)
        || (resource.data.partnerAId == request.auth.uid)
        || (resource.data.partnerBId == request.auth.uid)
      );
      // Client-side creation is limited to the caller's OWN solo group. Pair
      // groups are created exclusively by the trusted invite callable (admin
      // SDK), which bypasses these rules. Rules cannot observe other writes in
      // the same batch, so this must not depend on the caller's profile groupId.
      allow create: if isSignedIn() &&
        request.resource.data.partnerAId == request.auth.uid &&
        request.resource.data.partnerBId == "" &&
        isSoloGroup(groupId);
      allow update: if isSignedIn() && (
        isGroupPartner(resource.data) &&
        // Ownership identifiers are immutable once the group is created.
        request.resource.data.partnerAId == resource.data.partnerAId &&
        request.resource.data.partnerBId == resource.data.partnerBId
      );
      allow delete: if false;
    }

    // =========================================================================
    // Tasks collection
    // =========================================================================
    match /tasks/{taskId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Transactions collection
    //   - Client writes are treated as manual entries and must NOT claim a
    //     `recurrence` source or server-generated occurrence id. Recurring
    //     instances are written by a privileged backend (single writer) to
    //     guarantee idempotency.
    // =========================================================================
    match /transactions/{txId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId)
        && (request.resource.data.source == "manual" || request.resource.data.source == null)
        && !('occurrenceId' in request.resource.data);
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && (!('source' in request.resource.data) || request.resource.data.source == resource.data.source)
        && (!('occurrenceId' in request.resource.data) || request.resource.data.occurrenceId == resource.data.occurrenceId);
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Milestones collection
    // =========================================================================
    match /milestones/{milestoneId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId);
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Memories collection
    //   - Storage path mirrors the Firestore doc for lifecycle consistency.
    // =========================================================================
    match /memories/{memoryId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId)
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Savings Goals collection
    // =========================================================================
    match /savings_goals/{goalId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId);
      // Concurrency-safe: clients update only via atomic increment documents
      // handled by the backend; plain updates guarded to the same group.
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Nudges collection
    //   - Recipient marks read; sender/recipient read; sender must be self.
    // =========================================================================
    match /nudges/{nudgeId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.recipientId == myProfile().partnerId;
      allow update: if isSignedIn() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // =========================================================================
    // Invite codes (Phase 2.2) — server-generated, claim via callable function.
    // =========================================================================
    match /invite_codes/{codeId} {
      allow read: if false;
      allow create: if isServerAdmin();
      allow update: if isServerAdmin();
      allow delete: if isServerAdmin();
    }

    // =========================================================================
    // Recurrence schedules (Phase 2.2) — written by the recurring job.
    //   Clients may create/edit the schedule rule, but NOT the generated
    //   occurrence ledger; generated transactions live in /transactions.
    // =========================================================================
    match /recurrences/{recurrenceId} {
      allow read: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
      allow create: if isSignedIn() && isMemberOfGroup(request.resource.data.groupId);
      allow update: if isSignedIn() && isMemberOfGroup(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId;
      allow delete: if isSignedIn() && isMemberOfGroup(resource.data.groupId);
    }

    // =========================================================================
    // Export / delete jobs (Phase 2.4) — initiated via a callable function and
    //   run by a privileged backend; the owner reads status only.
    // =========================================================================
    match /jobs/{jobId} {
      allow read: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isServerAdmin());
      allow create, update, delete: if isServerAdmin();
    }

    // =========================================================================
    // Deny all other access by default
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
